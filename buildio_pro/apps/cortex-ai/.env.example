# PostgreSQL
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Valkey (Redis-compatible cache)
VALKEY_URL=

# Vercel AI Gateway (required for embeddings & chat)
# Run `vercel link && vercel env pull` to generate OIDC token automatically
# VERCEL_OIDC_TOKEN=

# Or use an API key directly (create at Vercel Dashboard → AI Gateway → API Keys)
AI_GATEWAY_API_KEY=

# Chat guardrail: scans user queries for harmful content and blocks risky ones.
# Enabled by default; set to "false" to disable. Optional dedicated model.
CHAT_GUARDRAIL_ENABLED=true
CHAT_GUARDRAIL_MODEL=openai/gpt-4o-mini

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Google OAuth (Better Auth)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

UPLOADTHING_TOKEN=