# env
NEXT_PUBLIC_ENV="dev"

# app URL
NEXT_PUBLIC_APP_URL=

# database - postgres
DATABASE_URL=

# authentication - better auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# enable email sign-up/login
ALLOW_EMAIL_LOGIN=
SEND_EMAIL_VERIFICATION=

# caching - valkey
VALKEY_URL=

# object storage - minio (S3-compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=

# auth providers 
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# email service - resend
RESEND_API_KEY=
