# env
NEXT_PUBLIC_ENV="dev"

# app URL
NEXT_PUBLIC_APP_URL=

# database - postgres
DATABASE_URL=

# authentication - better auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# enable email sign-up/login
ALLOW_EMAIL_LOGIN=
SEND_EMAIL_VERIFICATION=

# caching - valkey
VALKEY_URL=

# object storage - minio (S3-compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=

# ai extraction - vercel ai gateway (key starts with `vck_` / `vcst_`)
AI_GATEWAY_API_KEY=
# optional: scope requests to a specific Vercel team
AI_GATEWAY_TEAM_ID_OR_SLUG=
# default model used for statement extraction, e.g. google/gemini-2.5-flash
AI_EXTRACTION_MODEL=

# auth providers 
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# email service - resend
RESEND_API_KEY=
